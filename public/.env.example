# Copia este archivo como .env.local solo si vas a probar con "vercel dev".
# En producción estas variables se cargan en Vercel > Settings > Environment Variables.

# URL /exec de la implementación de Apps Script (Implementar > Gestionar implementaciones)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Mismo valor que la propiedad API_TOKEN del script (menú Servicio técnico > Generar token para Vercel)
API_TOKEN=pega-aqui-el-token
